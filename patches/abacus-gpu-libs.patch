@@ -0,0 +1,81 @@
+#include "../libxc_gpu.h"
+#include <xc_funcs.h>
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+int main()
+{
+    double worst = 0.0;
+    int checks = 0;
+    for (int spin : {1, 2})
+    {
+        for (int count : {17, 1025, 8193})
+        {
+            const int nsigma = spin == 1 ? 1 : 3;
+            std::vector<double> rho(count * spin);
+            std::vector<double> sigma(count * nsigma);
+            for (int i = 0; i < count; ++i)
+            {
+                for (int s = 0; s < spin; ++s)
+                {
+                    rho[i * spin + s] = 0.01 + 0.001 * ((i + 3 * s) % 400);
+                }
+                for (int s = 0; s < nsigma; ++s)
+                {
+                    sigma[i * nsigma + s] = 0.002 + 0.00001 * (i % 300);
+                }
+                if (spin == 2) { sigma[i * nsigma + 1] *= 0.3; }
+            }
+            XC_Functional_Libxc::GpuGrid grid(spin, count, rho, sigma);
+            for (int id : {XC_LDA_X, XC_GGA_X_PBE, XC_GGA_C_PBE, XC_HYB_GGA_XC_HSE06})
+            {
+                xc_func_type host;
+                xc_func_type device;
+                if (xc_func_init_flags(&host, id, spin, XC_FLAGS_ON_HOST) != 0
+                    || xc_func_init_flags(&device, id, spin, XC_FLAGS_ON_DEVICE) != 0)
+                {
+                    throw std::runtime_error("Could not initialize LibXC test functional");
+                }
+                std::vector<double> exc(count);
+                std::vector<double> vrho(count * spin);
+                std::vector<double> vsigma(count * nsigma);
+                std::vector<double> expected_exc(count);
+                std::vector<double> expected_vrho(count * spin);
+                std::vector<double> expected_vsigma(count * nsigma);
+                if (host.info->family == XC_FAMILY_LDA)
+                {
+                    xc_lda_exc_vxc(&host, count, rho.data(), expected_exc.data(), expected_vrho.data());
+                }
+                else
+                {
+                    xc_gga_exc_vxc(&host, count, rho.data(), sigma.data(), expected_exc.data(),
+                                   expected_vrho.data(), expected_vsigma.data());
+                }
+                grid.evaluate(device, exc, vrho, vsigma);
+                const auto compare = [&worst](const std::vector<double>& actual,
+                                               const std::vector<double>& expected)
+                {
+                    for (std::size_t i = 0; i < actual.size(); ++i)
+                    {
+                        const double scaled_error = std::abs(actual[i] - expected[i]) / (1.0 + std::abs(expected[i]));
+                        if (!std::isfinite(actual[i]) || scaled_error > 5e-10)
+                        {
+                            throw std::runtime_error("LibXC GPU result disagrees with CPU reference");
+                        }
+                        worst = std::max(worst, scaled_error);
+                    }
+                };
+                compare(exc, expected_exc);
+                compare(vrho, expected_vrho);
+                compare(vsigma, expected_vsigma);
+                xc_func_end(&host);
+                xc_func_end(&device);
+                ++checks;
+            }
+        }
+    }
+    std::cout << "PASS " << checks << " spin/grid/functional configurations; max scaled error " << worst << '\n';
+}
