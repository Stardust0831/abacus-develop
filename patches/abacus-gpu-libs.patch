+#ifndef ABACUS_LIBXC_GPU_H
+#define ABACUS_LIBXC_GPU_H
+
+#include <xc.h>
+#include <vector>
+
+namespace XC_Functional_Libxc
+{
+bool use_gpu_grid();
+
+// Experimental adapter: host density preparation and assembly are unchanged.
+// Own one contiguous device buffer for a complete local density grid.
+class GpuGrid
+{
+public:
+    GpuGrid(int nspin, int points, const std::vector<double>& rho,
+            const std::vector<double>& sigma);
+    ~GpuGrid();
+    GpuGrid(const GpuGrid&) = delete;
+    GpuGrid& operator=(const GpuGrid&) = delete;
+    void evaluate(const xc_func_type& func, std::vector<double>& exc,
+                  std::vector<double>& vrho, std::vector<double>& vsigma);
+
+private:
+    int points_ = 0;
+    int spin_ = 0;
+    int sigma_components_ = 0;
+    double* buffer_ = nullptr;
+    double* rho_ = nullptr;
+    double* sigma_ = nullptr;
+    double* exc_ = nullptr;
+    double* vrho_ = nullptr;
+    double* vsigma_ = nullptr;
+};
+}
+#endif
--- /dev/null
+++ b/source/source_hamilt/module_xc/libxc_gpu.cpp
@@ -0,0 +1,114 @@
+#include "libxc_gpu.h"
+#include <cuda_runtime_api.h>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace
+{
+void check_cuda(cudaError_t status)
+{
+    if (status != cudaSuccess)
+    {
+        const std::string message = cudaGetErrorString(status);
+        throw std::runtime_error("LibXC GPU adapter: " + message);
+    }
+}
+}
+
+namespace XC_Functional_Libxc
+{
+bool use_gpu_grid()
+{
+    const char* value = std::getenv("SAI_LIBXC_DEVICE");
+    if (value == nullptr || std::string(value) == "gpu") { return true; }
+    if (std::string(value) == "cpu") { return false; }
+    throw std::invalid_argument("SAI_LIBXC_DEVICE must be cpu or gpu");
+}
+
+GpuGrid::GpuGrid(int nspin, int points, const std::vector<double>& rho,
+                 const std::vector<double>& sigma)
+    : points_(points), spin_(nspin)
+{
+    if (points < 0 || (nspin != 1 && nspin != 2))
+    {
+        throw std::invalid_argument("Invalid LibXC GPU grid dimensions");
+    }
+    sigma_components_ = nspin == 1 ? 1 : 3;
+    const std::size_t rho_count = static_cast<std::size_t>(points) * spin_;
+    const std::size_t sigma_count = static_cast<std::size_t>(points) * sigma_components_;
+    if (rho.size() != rho_count || (!sigma.empty() && sigma.size() != sigma_count))
+    {
+        throw std::invalid_argument("LibXC GPU density/sigma size mismatch");
+    }
+    if (points == 0) { return; }
+    const std::size_t bytes = (2 * rho_count + 2 * sigma_count + points) * sizeof(double);
+    check_cuda(cudaMalloc(reinterpret_cast<void**>(&buffer_), bytes));
+    rho_ = buffer_;
+    sigma_ = rho_ + rho_count;
+    exc_ = sigma_ + sigma_count;
+    vrho_ = exc_ + points;
+    vsigma_ = vrho_ + rho_count;
+    try
+    {
+        check_cuda(cudaMemcpy(rho_, rho.data(), rho_count * sizeof(double), cudaMemcpyHostToDevice));
+        if (!sigma.empty())
+        {
+            check_cuda(cudaMemcpy(sigma_, sigma.data(), sigma_count * sizeof(double), cudaMemcpyHostToDevice));
+        }
+    }
+    catch (...)
+    {
+        cudaFree(buffer_);
+        buffer_ = nullptr;
+        throw;
+    }
+}
+
+GpuGrid::~GpuGrid()
+{
+    if (buffer_ != nullptr) { cudaFree(buffer_); }
+}
+
+void GpuGrid::evaluate(const xc_func_type& func, std::vector<double>& exc,
+                       std::vector<double>& vrho, std::vector<double>& vsigma)
+{
+    const std::size_t rho_count = static_cast<std::size_t>(points_) * spin_;
+    const std::size_t sigma_count = static_cast<std::size_t>(points_) * sigma_components_;
+    if (exc.size() != static_cast<std::size_t>(points_) || vrho.size() != rho_count
+        || vsigma.size() != sigma_count || func.nspin != spin_
+        || (func.info->flags & XC_FLAGS_ON_DEVICE) == 0)
+    {
+        throw std::invalid_argument("LibXC GPU output/functional mismatch");
+    }
+    if (points_ == 0) { return; }
+    const int family = func.info->family;
+    if (family == XC_FAMILY_LDA)
+    {
+        xc_lda_exc_vxc(&func, points_, rho_, exc_, vrho_);
+    }
+    else if (family == XC_FAMILY_GGA || family == XC_FAMILY_HYB_GGA)
+    {
+        xc_gga_exc_vxc(&func, points_, rho_, sigma_, exc_, vrho_, vsigma_);
+    }
+    else
+    {
+        throw std::invalid_argument("LibXC GPU adapter supports LDA and GGA families");
+    }
+    check_cuda(cudaGetLastError());
+    check_cuda(cudaMemcpy(exc.data(), exc_, points_ * sizeof(double), cudaMemcpyDeviceToHost));
+    check_cuda(cudaMemcpy(vrho.data(), vrho_, rho_count * sizeof(double), cudaMemcpyDeviceToHost));
+    if (family != XC_FAMILY_LDA)
+    {
+        check_cuda(cudaMemcpy(vsigma.data(), vsigma_, sigma_count * sizeof(double), cudaMemcpyDeviceToHost));
+    }
+    if (std::getenv("SAI_GPU_TRACE") != nullptr)
+    {
+        int device = 0;
+        check_cuda(cudaGetDevice(&device));
+        std::clog << "LIBXC_GPU_EVAL device=" << device << " functional=" << func.info->number
+                  << " points=" << points_ << '\n';
+    }
+}
+}
