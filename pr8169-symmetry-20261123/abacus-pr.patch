diff --git a/tests/lcao_hse_gpu/cmake/CMakeLists.txt b/tests/lcao_hse_gpu/cmake/CMakeLists.txt
new file mode 100644
index 000000000..c78acde4a
--- /dev/null
+++ b/tests/lcao_hse_gpu/cmake/CMakeLists.txt
@@ -0,0 +1,27 @@
+cmake_minimum_required(VERSION 3.18)
+project(libri_consumer_check LANGUAGES CXX)
+
+# Exercise the dependency target without ABACUS's global includes or link flags.
+list(PREPEND CMAKE_MODULE_PATH
+     "${CMAKE_CURRENT_LIST_DIR}/../../../cmake/modules")
+option(ENABLE_OPENMP "Enable OpenMP" ON)
+option(ENABLE_LIBRI_GPU "Check the LibRI CUDA dependency interface" OFF)
+find_package(MPI REQUIRED COMPONENTS CXX)
+if(ENABLE_OPENMP)
+  find_package(OpenMP REQUIRED COMPONENTS CXX)
+endif()
+if(MKLROOT
+   OR MKL_ROOT
+   OR DEFINED ENV{MKLROOT})
+  find_package(MKL REQUIRED)
+else()
+  find_package(Lapack REQUIRED)
+endif()
+find_package(LibRI REQUIRED)
+
+add_executable(libri_consumer test_libri_consumer.cpp)
+target_link_libraries(libri_consumer PRIVATE LibRI::LibRI)
+target_compile_definitions(
+  libri_consumer PRIVATE $<$<BOOL:${ENABLE_LIBRI_GPU}>:EXPECT_LIBRI_GPU>)
+enable_testing()
+add_test(NAME libri_consumer COMMAND libri_consumer)
diff --git a/tests/lcao_hse_gpu/cmake/test_libri_consumer.cpp b/tests/lcao_hse_gpu/cmake/test_libri_consumer.cpp
new file mode 100644
index 000000000..6ab8e5a5b
--- /dev/null
+++ b/tests/lcao_hse_gpu/cmake/test_libri_consumer.cpp
@@ -0,0 +1,27 @@
+#include <RI/ri/LRI.h>
+
+#if defined(EXPECT_LIBRI_GPU)
+#if !defined(__GPU_RI) || !defined(__DDLA_RI) || !defined(DDLA_USE_CUDA)
+#error "LibRI GPU usage requirements did not reach the consumer"
+#endif
+#else
+#if defined(__GPU_RI) || defined(__DDLA_RI) || defined(DDLA_USE_CUDA)
+#error "CPU LibRI consumer unexpectedly requires a GPU backend"
+#endif
+#endif
+
+int main()
+{
+    RI::LRI<int, int, 3, double> lri;
+#ifdef EXPECT_LIBRI_GPU
+    if (lri.cal_mode != RI::LRI_Cal_Mode::CPU)
+    {
+        return 1;
+    }
+    lri.cal_mode = RI::LRI_Cal_Mode::GPU;
+#endif
+    // The consumer must receive the BLAS dependency through LibRI::LibRI.
+    const double data[] = {3.0, 4.0};
+    const double norm = RI::Blas_Interface::nrm2(2, data);
+    return norm == 5.0 ? 0 : 1;
+}
