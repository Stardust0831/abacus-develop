# Copy this file outside the ABACUS checkout before editing it.
# The private key stays in the OpenSSH configuration referenced below.
SAI_SSH_CONFIG=$HOME/.ssh/config
SAI_SSH_TARGET=SAI-abacus
SAI_PROJECT_ROOT=/home/your-sai-user/agent/abacus_sai_gpu_ci
SAI_RUN_NAMESPACE=local
SAI_ARTIFACT_ROOT=$HOME/abacus-sai-artifacts
# SAI_SOURCE_REF defaults to HEAD and may name any locally available commit.
# A command-line --source-ref takes precedence. SAI_SOURCE_SHA remains a
# compatibility fallback for older local configuration files.
# SAI_SOURCE_REF=my-local-branch
