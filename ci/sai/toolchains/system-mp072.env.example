# Runner-local profile for the cuSolverMp/cuBLASMp bundled with NVHPC 26.3.

export SAI_PROFILE_NAME=system-mp072
export SAI_DEPENDENCY_ROOT=${SAI_DEPENDENCY_ROOT:-$HOME/agent/abacus_beta6_build}
export SAI_DEPS_PREFIX=${SAI_DEPS_PREFIX:-$SAI_DEPENDENCY_ROOT/deps-full}
export SAI_CNPY_SOURCE=${SAI_CNPY_SOURCE:-$SAI_DEPENDENCY_ROOT/dependency-sources/cnpy}
export SAI_DEEPMD_ROOT=${SAI_DEEPMD_ROOT:-$SAI_DEPENDENCY_ROOT/deps-deepmd-pt-only}
export SAI_CMAKE_PREFIX_ROOT=${SAI_CMAKE_PREFIX_ROOT:-$SAI_DEPENDENCY_ROOT/cmake-prefix}

export SAI_NVHPC_ROOT=${SAI_NVHPC_ROOT:-/opt/devtools/nvidia/hpc_sdk/Linux_x86_64/26.3}
export SAI_CUDA_ROOT=${SAI_CUDA_ROOT:-/opt/devtools/nvidia/cuda-12.9.1}
export SAI_NCCL_ROOT=${SAI_NCCL_ROOT:-$SAI_NVHPC_ROOT/comm_libs/12.9/nccl-2.29}
export SAI_CUSOLVERMP_ROOT=${SAI_CUSOLVERMP_ROOT:-$SAI_NVHPC_ROOT/math_libs/12.9/targets/x86_64-linux}
export SAI_CUBLASMP_ROOT=${SAI_CUBLASMP_ROOT:-$SAI_NVHPC_ROOT/math_libs/12.9/targets/x86_64-linux}

export SAI_TORCH_ROOT=${SAI_TORCH_ROOT:-/opt/apps/conda_env/deepmd-kit-3.1.2}
export SAI_REFERENCE_ROOT=${SAI_REFERENCE_ROOT:-/opt/apps/abacus/abacus-develop-3.9.0.26_nvhpc263gnu/toolchain/install}
export SAI_FFTW_INCLUDE=${SAI_FFTW_INCLUDE:-/opt/devtools/fftw/fftw-3.3.10/include}
export SAI_BUILD_JOBS=${SAI_BUILD_JOBS:-32}

sai_load_toolchain() {
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
    export LD_PRELOAD=${LD_PRELOAD:-}
    export CPATH=${CPATH:-}
    export CMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH:-}
    source /etc/profile.d/lmod.sh
    module purge
    module load cmake/3.31.6
    module load nvhpc/26.3-gnu-cuda12-tuned
    module load openmpi/5.0.10-nvhpc26.3-gnu-cuda12-auto
    module load fftw/3.3.10 libxc/7.0.0-auto saiblas/2603-gnu-auto
    module load elpa/2026.02.001-2603-gnu cuda/12.9.1
    module unload nccl >/dev/null 2>&1 || true

    SAI_MPI_ROOT=$(cd "$(dirname "$(command -v mpicc)")/.." && pwd)
    export SAI_MPI_ROOT
    export PATH="$SAI_MPI_ROOT/bin:$SAI_CUDA_ROOT/bin:$PATH"
    export LD_LIBRARY_PATH="$SAI_MPI_ROOT/lib:$SAI_CUDA_ROOT/lib64:$SAI_CUSOLVERMP_ROOT/lib:$SAI_CUBLASMP_ROOT/lib:$SAI_NVHPC_ROOT/math_libs/12.9/lib64:$SAI_NCCL_ROOT/lib:$SAI_DEPS_PREFIX/lib:$SAI_DEPS_PREFIX/lib64:$SAI_DEEPMD_ROOT/lib:$SAI_TORCH_ROOT/lib:$SAI_REFERENCE_ROOT/NEP_CPU-main/lib:${LD_LIBRARY_PATH:-}"
}
