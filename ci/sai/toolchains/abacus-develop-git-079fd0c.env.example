#!/usr/bin/env bash

# Site-managed ABACUS module with the validated CUDA 12.9 and NVIDIA MP 0.9 stack.
export SAI_PROFILE_NAME=module-abacus-develop-git-079fd0c
export SAI_ABACUS_MODULE=abacus/develop-git-079fd0c-260724-sm70-auto
export SAI_ABACUS_MODULE_COMMIT=079fd0cff4e91abc25b6e2809114cfbeac94720e
export SAI_NVHPC_ROOT=/opt/devtools/nvidia/hpc_sdk/Linux_x86_64/26.3
export SAI_CUDA_ROOT=/opt/devtools/nvidia/cuda-12.9.1
export SAI_CUSOLVERMP_ROOT=/opt/devtools/nvidia/mp_libs
export SAI_CUBLASMP_ROOT=/opt/devtools/nvidia/mp_libs
export SAI_REQUIRE_NCCL_SAI_RAIL_BY_CHANNEL=1
export NCCL_SAI_RAIL_BY_CHANNEL=1
export SAI_BUILD_JOBS=${SAI_BUILD_JOBS:-32}

sai_load_toolchain() {
    if [[ -n ${LD_PRELOAD:-} ]]; then
        printf 'LD_PRELOAD must be empty for the SAI NCCL control: %q\n' "$LD_PRELOAD" >&2
        return 1
    fi
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
    export LD_PRELOAD=
    export CPATH=${CPATH:-}
    export CMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH:-}
    source /etc/profile.d/lmod.sh
    module purge
    module load cmake/3.31.6
    module load "$SAI_ABACUS_MODULE"

    [[ ${ABACUS_HOME:-} == /opt/apps/abacus/abacus-develop-git-079fd0c-260724 ]] || {
        printf 'Unexpected ABACUS_HOME from %s: %q\n' \
            "$SAI_ABACUS_MODULE" "${ABACUS_HOME:-}" >&2
        return 1
    }
    [[ ${ABACUS_COMMIT:-} == "$SAI_ABACUS_MODULE_COMMIT" ]] || {
        printf 'Unexpected ABACUS_COMMIT from %s: %q\n' \
            "$SAI_ABACUS_MODULE" "${ABACUS_COMMIT:-}" >&2
        return 1
    }
    [[ -x $ABACUS_HOME/bin/abacus ]] || {
        printf 'ABACUS module binary is missing: %s/bin/abacus\n' \
            "$ABACUS_HOME" >&2
        return 1
    }

    # The ABACUS module loads nvmplibs last, so MP 0.9 takes precedence over
    # the older copies bundled in NVHPC 26.3.
    : "${NCCL_ROOT:?$SAI_ABACUS_MODULE must export NCCL_ROOT}"
    export SAI_NCCL_ROOT=$NCCL_ROOT
    SAI_MPI_ROOT=$(cd "$(dirname "$(command -v mpicc)")/.." && pwd)
    export SAI_MPI_ROOT
    export NCCL_ROOT=$SAI_NCCL_ROOT
    export NCCL_HOME=$SAI_NCCL_ROOT
    export NCCL_PATH=$SAI_NCCL_ROOT
    export PATH="$SAI_MPI_ROOT/bin:$SAI_CUDA_ROOT/bin:$PATH"
    export LD_LIBRARY_PATH="$SAI_MPI_ROOT/lib:$SAI_CUDA_ROOT/lib64:$SAI_CUSOLVERMP_ROOT/lib:$SAI_NCCL_ROOT/lib:$SAI_NVHPC_ROOT/math_libs/12.9/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
}
