#!/usr/bin/env bash

# SAI's CUDA 12.4-era NVHPC stack. cuSolverMp 0.5 uses CAL rather than NCCL.
export SAI_PROFILE_NAME=nvhpc245-cal-mp050-nccl218
export SAI_PROJECT_ROOT=${SAI_PROJECT_ROOT:-$HOME/agent/abacus_sai_gpu_ci}
export SAI_NVHPC_ROOT=/opt/devtools/nvidia/hpc_sdk/Linux_x86_64/24.5
export SAI_CUDA_ROOT=/opt/devtools/nvidia/cuda-12.4.1
export SAI_MP_ROOT=$SAI_NVHPC_ROOT/math_libs/12.4/targets/x86_64-linux
export SAI_MATH_LIB_ROOT=$SAI_NVHPC_ROOT/math_libs/12.4
export SAI_CUSOLVERMP_ROOT=$SAI_MP_ROOT
export SAI_CUBLASMP_ROOT=$SAI_MP_ROOT
export SAI_CAL_ROOT=$SAI_MP_ROOT

# This is the exact root exported by module nccl/2.18.5-sai-cuda12.4. Loading
# that module together with nvhpc/24.5 is blocked by Lmod's conflict rule, so
# the profile uses the module's immutable installation root directly.
export SAI_NCCL_ROOT=/opt/devtools/nvidia/nccl_2.18.5_cuda12.4_sai_v2.18.5-1-sai.1
export SAI_BUILD_JOBS=${SAI_BUILD_JOBS:-32}

sai_load_toolchain() {
    export LD_LIBRARY_PATH=
    export LD_PRELOAD=
    export CPATH=
    export CMAKE_PREFIX_PATH=
    export LIBRARY_PATH=
    export C_INCLUDE_PATH=
    export CPLUS_INCLUDE_PATH=
    source /etc/profile.d/lmod.sh
    module purge
    module load cmake/3.31.6
    module load openmpi/5.0.8-nvhpc24.5-gnu-auto
    module load fftw/3.3.10 libxc/7.0.0-auto saiblas/2603-gnu-auto

    SAI_MPI_ROOT=$(cd "$(dirname "$(command -v mpicc)")/.." && pwd)
    export SAI_MPI_ROOT
    export NCCL_ROOT=$SAI_NCCL_ROOT
    export NCCL_HOME=$SAI_NCCL_ROOT
    export NCCL_PATH=$SAI_NCCL_ROOT
    export PATH="$SAI_MPI_ROOT/bin:$SAI_CUDA_ROOT/bin:$PATH"
    export SAI_RUNTIME_LIBRARY_PATH="$SAI_MPI_ROOT/lib:$SAI_CUDA_ROOT/lib64:$SAI_MP_ROOT/lib:$SAI_MATH_LIB_ROOT/lib64:$SAI_NCCL_ROOT/lib"
    export LD_LIBRARY_PATH="$SAI_RUNTIME_LIBRARY_PATH:${LD_LIBRARY_PATH:-}"
}
